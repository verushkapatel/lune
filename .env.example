# Copy to .env for local development. On a hosted deployment set these in your
# host's dashboard instead, and never commit a real key.
#
# Lune works in two modes:
#
#   Local    Each person adds their own key in Settings. Leave everything below
#            commented out. Costs you nothing.
#
#   Hosted   You provide the key and visitors just sign up. Set OPENAI_API_KEY
#            below and read the spend limits section carefully, because your
#            key pays for every message.
#
#   OpenAI     https://platform.openai.com/api-keys
#   Anthropic  https://console.anthropic.com/settings/keys

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Override the default model. Must be vision-capable to read score photos.
# LUNE_MODEL=gpt-4o


# --- Spend limits (hosted mode) -------------------------------------------
# These apply only to requests that spend the key above. A user who saves their
# own key in Settings is never counted, because it costs you nothing.
# Counters are kept in the database, so they survive restarts.

# LUNE_USER_DAILY_LIMIT=40       # messages per account per day
# LUNE_INSTANCE_DAILY_LIMIT=400  # ceiling across everyone; a circuit breaker
# LUNE_BURST_PER_MINUTE=6        # blunts rapid-fire requests

# Also set a hard monthly cap at platform.openai.com/settings/organization/limits


# --- Who can sign up -------------------------------------------------------
# On a public URL, open signup means strangers spending your credit.

# LUNE_INVITE_CODE=some-phrase
# LUNE_ALLOW_SIGNUP=false


# --- Deployment ------------------------------------------------------------

# LUNE_HTTPS=true                # mark session cookies Secure; set when on HTTPS
# LUNE_DATA_DIR=/data            # database location; must be a persistent disk
# LUNE_ALLOWED_ORIGINS=https://your.app   # only if another origin calls the API
